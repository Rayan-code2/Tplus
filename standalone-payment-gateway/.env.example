# ============================================================================
# 🛡️ TETHERPLUS STANDALONE PAYMENT GATEWAY (pay.tetherplus.live)
# ============================================================================
# Place this file as .env inside /var/www/payment-gateway on your VPS

PORT=5000

# 1. Hot Wallet Address (Public BSC BEP20 Address)
HOT_WALLET_ADDRESS="0x6b8Ff2388d4aA6D208249AfcFDb14405Fb3f4679"

# 2. Hot Wallet Private Key (64-character hex private key for automated payouts)
# KEEP THIS STRICTLY SECRET ON VPS ONLY! NEVER COMMIT TO GITHUB!
HOT_WALLET_PRIVATE_KEY=""

# 3. Internal Payout Secret Token (Shared with main website server.ts)
INTERNAL_PAYOUT_SECRET="tetherplus_secure_internal_key_2026"

# 4. Binance Smart Chain RPC Node
BSC_RPC_URL="https://bsc-dataseed.binance.org/"
